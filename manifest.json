{
    "manifest_version": 3,
    "name": "Custom HubSpot",
    "version": "1.0",
    "description": "Customizes HubSpot UI for our company.",
    "permissions": ["scripting", "tabs", "storage"],
    "host_permissions": ["https://*.hubspot.com/*"],
    "icons": {
        "16": "icon16.png",
        "32": "icon32.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icon16.png",
            "32": "icon32.png"
        }
    },
    "content_scripts": [
        {
            "matches": ["https://*.hubspot.com/*"],
            "js": ["content.js"],
            "css": ["styles.css"]
        }
    ]
}
  